name: plataform-course2
services:
    plataforma-cursos:
        cpu_shares: 90
        command: []
        container_name: plataforma-cursos
        deploy:
            resources:
                limits:
                    memory: "32454475776"
        environment:
            ADMIN_DEFAULT_NAME: Admin
            ADMIN_DEFAULT_PASSWORD: admin123
            BACKUP_DIR: /app/backups
            COURSES_INTERNAL_PATH: /cursos
            DATABASE_URL: postgresql+psycopg://casaos:casaos@192.168.100.28:5432/Plataform-Course
            FLASK_ENV: production
            PYTHONUNBUFFERED: "1"
            SECRET_KEY: SUA_SECRET_KEY
            SESSION_COOKIE_SECURE: "false"
            UPLOAD_FOLDER: /app/uploads
        hostname: plataforma-cursos
        healthcheck:
            test:
                - CMD
                - curl
                - -f
                - http://localhost:9823/api/debug/routes
            timeout: 10s
            interval: 30s
            retries: 3
            start_period: 40s
        image: ghcr.io/alanisoliveira/plataform-course2:latest
        networks:
            plataforma-network: null
        ports:
            - mode: ingress
              target: 9823
              published: "9823"
              protocol: tcp
        restart: unless-stopped
        volumes:
            - type: bind
              source: /DATA/Cursos
              target: /Cursos
            - type: bind
              source: /DATA
              target: /DATA
networks:
    default:
        name: plataform-course2_default
    plataforma-network:
        name: plataform-course2_plataforma-network
        driver: bridge
x-casaos:
    author: self
    category: self
    hostname: ""
    icon: ""
    index: /
    is_uncontrolled: false
    port_map: "9823"
    scheme: http
    title:
        custom: Cursos
