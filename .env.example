# Porta da aplicação
PORT=9823
APP_IMAGE=ghcr.io/alanisoliveira/plataform-course2:latest

# Caminho dos cursos no host
COURSES_PATH=/DATA/Cursos
COURSES_INTERNAL_PATH=/cursos

# Segurança da aplicação
SECRET_KEY=troque-por-uma-chave-forte
ADMIN_DEFAULT_NAME=Admin
ADMIN_DEFAULT_PASSWORD=troque-por-uma-senha-forte
SESSION_COOKIE_SECURE=false

# Banco PostgreSQL externo
POSTGRES_HOST=SEU_HOST_POSTGRES
POSTGRES_PORT=5432
POSTGRES_DB=Plataform-Course
POSTGRES_USER=casaos
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql+psycopg://casaos:troque-por-uma-senha-forte@SEU_HOST_POSTGRES:5432/Plataform-Course

# App
FLASK_ENV=production
